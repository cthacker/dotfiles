#
# Executes commands at the start of an interactive session.
#

# === Core Zsh Configuration === #

# OS detection
if [[ "$OSTYPE" == "darwin"* ]]; then
  export MACOS=true
else
  export MACOS=false
fi

# History settings
HISTFILE=~/.zsh_history
HISTSIZE=50000   # must exceed SAVEHIST for hist_expire_dups_first to work
SAVEHIST=40000
setopt appendhistory
setopt hist_expire_dups_first
setopt hist_ignore_dups
setopt hist_ignore_space
setopt hist_verify
setopt share_history
# Keep trivial commands out of history (they'd only add noise to Ctrl-R, Up,
# the inline suggestion and the history-first completion group).
HISTORY_IGNORE='(ls|ll|la|lt|lrt|cd|cd ..|..|pwd|exit|clear|gs|gws|history|d)'
zshaddhistory() {
  emulate -L zsh
  setopt extendedglob
  [[ ${1%%$'\n'} != ${~HISTORY_IGNORE} ]]
}

# === Completion function path === #
# Everything that adds to fpath must run before the single compinit below.

# Homebrew: sets PATH and FPATH (~/.zprofile normally does this already on macOS)
if [[ "$MACOS" == true ]]; then
  if [ -f "/opt/homebrew/bin/brew" ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
  elif [ -f "/usr/local/bin/brew" ]; then
    eval "$(/usr/local/bin/brew shellenv)"
  fi
fi

# grok completions (its bin dir is in the path array further down)
[[ -d "$HOME/.grok/completions/zsh" ]] && fpath=("$HOME/.grok/completions/zsh" $fpath)

# Hand-written or generated completions tracked in this repo (e.g. _herdr).
# (-/FN): follow symlinks, directories only, non-empty, no error if missing.
fpath=(${${(%):-%N}:A:h}/completions(-/FN) $fpath)

# Basic auto/tab completion with daily cache refresh
zmodload zsh/complist
autoload -Uz compinit
if [[ -n ~/.zcompdump(#qN.mh+24) ]]; then
  compinit
else
  compinit -C
fi
# === Tab completion === #
# Native menu selection (fish-style): Tab lists matches below the prompt, Tab
# again cycles through them, rewriting the word on the command line in place.
# The cursor never leaves the command line; typing any character leaves the
# menu and keeps editing. fzf is deliberately not involved in Tab.
zstyle ':completion:*' menu select
zstyle ':completion:*' group-name ''
zstyle ':completion:*:descriptions' format '%F{8}%d%f'
zstyle ':completion:*' verbose yes
zstyle ':completion:*' list-dirs-first true
zstyle ':completion:*:cd:*' ignore-parents parent pwd  # cd ../<Tab> doesn't offer the dir you're in

# kill <Tab>: process list; typing part of a command name resolves to its PID
zstyle ':completion:*:*:*:*:processes' command 'ps -u $LOGNAME -o pid,user,command -w'
zstyle ':completion:*:*:kill:*:processes' list-colors '=(#b) #([0-9]#) ([0-9a-z-]#)*=01;36=0=01'
zstyle ':completion:*:*:kill:*' menu yes select
zstyle ':completion:*:*:kill:*' force-list always
zstyle ':completion:*:*:kill:*' insert-ids single
zstyle ':completion:*:(rm|kill|diff):*' ignore-line other
zstyle ':completion:*' file-sort modification # newest first, like `ll`
zstyle ':completion:*' special-dirs true      # complete . and ..
setopt AUTO_PARAM_SLASH                       # add slash when completing directories
setopt COMPLETE_IN_WORD                       # complete from the cursor, using text on both sides
setopt ALWAYS_TO_END                          # ...then move the cursor to the end of the match
unsetopt COMPLETE_ALIASES                     # complete alias as the real command

# History-aware completion: arguments previously used with the same command
# are offered first (dimmed), followed by the normal completions.
_history_args() {
  (( CURRENT > 1 )) || return 1
  # Aliases are expanded before completion (COMPLETE_ALIASES is unset), so
  # match history on the command as typed (e.g. `ls`) and as expanded (`eza`).
  local cmd=$words[1] typed=${${(z)LBUFFER}[1]}
  [[ -n $cmd ]] || return 1
  # If the word is exactly an existing directory, let file completion win this
  # Tab so it adds the slash (`cd ..` -> `cd ../`); history returns on the next Tab.
  [[ -n $PREFIX && $PREFIX != */ && -d ${PREFIX/#\~/$HOME} ]] && return 1
  typed=${typed:-$cmd}
  local -a args
  local key word expanded
  local cdlike=0
  [[ $typed == (cd|pushd) || $cmd == (cd|pushd) ]] && cdlike=1
  # (b) quotes pattern characters so a typed `[` or `*` can't break matching
  for key in ${(Onk)history[(R)(${(b)typed}|${(b)cmd}) *]}; do   # newest first
    for word in ${(z)history[$key]}; do
      [[ $word == ('&&'|'||'|';'|'|') ]] && break                   # stop at the next command
      [[ $word == (${(b)typed}|${(b)cmd}) ]] && continue
      [[ -z $PREFIX || $word == (#i)*${(b)PREFIX}* ]] || continue
      # Relative paths recorded in another directory are meaningless here, and
      # directories get a trailing slash like file completion (`..` -> `../`).
      expanded=${word/#\~/$HOME}
      if (( cdlike )); then
        [[ -d $expanded ]] || continue                # cd args must be dirs from *here*
        [[ ${expanded:A} == ${PWD:A} ]] && continue   # like ignore-parents
        [[ $word != */ ]] && word+=/
      elif [[ $word == (-*|*://*) ]]; then
        :                                             # flags and URLs pass through
      elif [[ $word == */* ]]; then
        [[ -e $expanded ]] || continue                # path-like: must exist from here
        [[ -z $PREFIX || $PREFIX == */ ]] || continue # mid-segment: let files finish it
        [[ -d $expanded && $word != */ ]] && word+=/
      elif [[ -d $expanded ]]; then
        continue  # plain word naming a real dir: file completion offers it better
      fi
      args+=($word)
    done
    (( $#args >= 60 )) && break
  done
  args=(${(u)args})
  (( $#args )) || return 1
  _wanted history-words expl 'history' compadd -Q -a args
}
_history_then_complete() {
  _history_args
  _complete
  # Some completion functions (e.g. git's) return non-zero even after adding
  # matches; judge by the match count so _approximate only runs when nothing matched.
  (( compstate[nmatches] > 0 ))
}
zstyle ':completion:*' completer _expand _history_then_complete _ignored _approximate
zstyle ':completion:*' group-order history-words
zstyle ':completion:*:history-words' list-colors '=*=2'   # dim, like the inline suggestion

# Substring matching (case-insensitive, partial words, substrings)
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' 'r:|[._-]=* r:|=*' 'l:|=* r:|=*'

# Colours for files/dirs in the list. LS_COLORS is empty on macOS, so fall back
# to a small built-in palette; kept out of the environment so eza is unaffected.
_comp_colors=${LS_COLORS:-'di=1;34:ln=36:ex=32:so=35:pi=33:bd=1;33:cd=1;33:or=31:mi=31'}
zstyle ':completion:*' list-colors ${(s.:.)_comp_colors} 'ma=7'
unset _comp_colors

# Useful options
setopt auto_cd
setopt extended_glob
setopt nomatch
setopt interactive_comments # allow '# comment' on the command line
setopt rc_quotes            # 'it''s' instead of 'it'\''s'
setopt no_rm_star_silent    # confirm before `rm *` (zsh's default, made explicit)
setopt notify
setopt prompt_subst

# === Plugins === #

# Inside the completion menu, Shift-Tab steps backwards
bindkey -M menuselect '^[[Z' reverse-menu-complete

# Source a zsh plugin by name: Homebrew (wherever it lives), then distro paths.
source_plugin() {
  local f
  for f in ${HOMEBREW_PREFIX:+$HOMEBREW_PREFIX/share/$1/$1.zsh} \
           /usr/share/$1/$1.zsh /usr/share/zsh/plugins/$1/$1.zsh; do
    [[ -r $f ]] && { source "$f"; return 0 }
  done
  return 1
}

# zsh-autosuggestions: inline grey text from history first, then completions
ZSH_AUTOSUGGEST_STRATEGY=(history completion)
ZSH_AUTOSUGGEST_HISTORY_IGNORE='?(#c120,)'   # never suggest lines over 120 chars
ZSH_AUTOSUGGEST_BUFFER_MAX_SIZE=40           # stop suggesting once the line is long
source_plugin zsh-autosuggestions

# zsh-history-substring-search
source_plugin zsh-history-substring-search

# === Alias Definitions === #

# Common aliases
alias vim='nvim'

# Modern replacements
if command -v bat &> /dev/null; then
  alias cat='bat'
fi

if command -v eza &> /dev/null; then
  alias ls='eza'
  alias ll='eza -l -snew'
  alias la='eza -la'
  alias lt='eza -T' # Tree listing
  alias lrt='eza -lh --sort=modified'

else
  # OS-specific ls aliases
  if [[ "$MACOS" == true ]]; then
    alias ls='ls -G'
  else
    alias ls='ls --color=auto'
  fi
  alias ll='ls -l'
  alias la='ls -la'
fi

# Git aliases
alias gs='git status'
alias gws='git status --short'
alias gc='git commit'
alias gca='git commit --amend'
alias gp='git push'
alias gl='git pull'
alias glo='git log --oneline --decorate'
alias gla='git log --pretty=oneline --abbrev-commit'
alias gls='git log --stat'
alias ga='git add'
alias gaa='git add --all'
alias gd='git diff'
alias gds='git diff --staged'
alias gb='git branch'
alias gba='git branch -a'
alias gco='git checkout'
alias gcb='git checkout -b'
alias gfa='git fetch --all'
alias gpr='git pull --rebase'
alias gcR='git reset "HEAD^"'
alias gss='git stash save'
alias gsp='git stash pop'
alias gsl='git stash list'


# Docker aliases
alias dockerclean='docker rmi $(docker images -f "dangling=true" -q); docker volume rm $(docker volume ls -qf dangling=true)'

# Increase max open files for macOS
if [[ "$MACOS" == true ]]; then
  ulimit -n 2048
fi

# === Path Configuration === #

# pnpm home (used by pnpm itself and in the path array below)
if [[ "$MACOS" == true ]]; then
  export PNPM_HOME="$HOME/Library/pnpm"
else
  export PNPM_HOME="$HOME/.local/share/pnpm"
fi

# PATH as a unique array: the first occurrence wins, and (N) drops directories
# that don't exist on this machine. Homebrew, conda and nvm prepend later.
typeset -gU path fpath cdpath
path=(
  $HOME/.local/bin(N)
  /opt/homebrew/share/google-cloud-sdk/bin(N)
  $HOME/.cargo/bin(N)
  $HOME/.yarn/bin(N) $HOME/.config/yarn/global/node_modules/.bin(N)
  ${PNPM_HOME}(N)
  $HOME/.grok/bin(N)
  $path
  $HOME/.lmstudio/bin(N)
)

# Google Cloud SDK path - OS specific
if [[ "$MACOS" == true ]]; then
  # macOS path
  if [ -f "$HOME/google-cloud-sdk/path.zsh.inc" ]; then
    source "$HOME/google-cloud-sdk/path.zsh.inc"
  fi
  if [ -f "$HOME/google-cloud-sdk/completion.zsh.inc" ]; then
    source "$HOME/google-cloud-sdk/completion.zsh.inc"
  fi
else
  # Linux path
  if [ -f "$HOME/google-cloud-sdk/path.zsh.inc" ]; then
    source "$HOME/google-cloud-sdk/path.zsh.inc"
  elif [ -f "$HOME/Downloads/google-cloud-sdk/path.zsh.inc" ]; then
    source "$HOME/Downloads/google-cloud-sdk/path.zsh.inc"
  fi
  if [ -f "$HOME/google-cloud-sdk/completion.zsh.inc" ]; then
    source "$HOME/google-cloud-sdk/completion.zsh.inc"
  elif [ -f "$HOME/Downloads/google-cloud-sdk/completion.zsh.inc" ]; then
    source "$HOME/Downloads/google-cloud-sdk/completion.zsh.inc"
  fi
fi

# FZF: draw below the cursor instead of taking over the screen
export FZF_DEFAULT_OPTS='--height 40% --layout reverse --border top'
if [[ "$MACOS" == true ]]; then
  export FZF_CTRL_R_OPTS="--bind 'ctrl-y:execute-silent(echo -n {2..} | pbcopy)+abort' --header 'CTRL-Y copies the command'"
fi
export FZF_CTRL_T_OPTS="--walker-skip .git,node_modules,target --preview 'bat -n --color=always {}'"
export FZF_ALT_C_OPTS="--walker-skip .git,node_modules,target --preview 'eza -T --level=2 --color=always {}'"
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh
bindkey '^I' expand-or-complete   # fzf keeps Ctrl-R/Ctrl-T/Alt-C; Tab never invokes fzf

# Conda initialize - OS specific
if [[ "$MACOS" == true ]]; then
  # macOS Conda setup
  if [ -f "$HOME/miniconda3/bin/conda" ]; then
    __conda_setup="$("$HOME/miniconda3/bin/conda" 'shell.zsh' 'hook' 2> /dev/null)"
    if [ $? -eq 0 ]; then
      eval "$__conda_setup"
    else
      if [ -f "$HOME/miniconda3/etc/profile.d/conda.sh" ]; then
        . "$HOME/miniconda3/etc/profile.d/conda.sh"
      else
        export PATH="$HOME/miniconda3/bin:$PATH"
      fi
    fi
    unset __conda_setup
  fi
else
  # Linux Conda setup
  if [ -f "$HOME/miniconda3/bin/conda" ]; then
    __conda_setup="$("$HOME/miniconda3/bin/conda" 'shell.zsh' 'hook' 2> /dev/null)"
    if [ $? -eq 0 ]; then
      eval "$__conda_setup"
    else
      if [ -f "$HOME/miniconda3/etc/profile.d/conda.sh" ]; then
        . "$HOME/miniconda3/etc/profile.d/conda.sh"
      else
        export PATH="$HOME/miniconda3/bin:$PATH"
      fi
    fi
    unset __conda_setup
  fi
fi

# === Keybindings === #
bindkey -e  # Use emacs key bindings

# Alt-Backspace deletes back to the previous / instead of the whole path
slash-backward-kill-word() { local WORDCHARS="${WORDCHARS:s@/@}"; zle backward-kill-word }
zle -N slash-backward-kill-word
bindkey '^[^?' slash-backward-kill-word
bindkey '^[^H' slash-backward-kill-word

# Ctrl-Z on an empty line resumes the last suspended job; on a non-empty line it
# stashes what you typed and gives it back at the next prompt
fancy-ctrl-z() {
  if [[ $#BUFFER -eq 0 ]]; then
    BUFFER="fg"
    zle accept-line -w
  else
    zle push-input -w
    zle clear-screen -w
  fi
}
zle -N fancy-ctrl-z
bindkey '^Z' fancy-ctrl-z

# Bind up/down arrows to history substring search if available, otherwise use default
if (( $+widgets[history-substring-search-up] )); then
  bindkey '^[[A' history-substring-search-up     # Up arrow
  bindkey '^[[B' history-substring-search-down   # Down arrow
  bindkey '^P' history-substring-search-up       # Ctrl+P
  bindkey '^N' history-substring-search-down     # Ctrl+N
else
  # Fallback to standard history search
  bindkey '^[[A' up-line-or-history       # Up arrow
  bindkey '^[[B' down-line-or-history     # Down arrow
  autoload -U history-search-end
  zle -N history-beginning-search-backward-end history-search-end
  zle -N history-beginning-search-forward-end history-search-end
  bindkey "^[[A" history-beginning-search-backward-end  # Up arrow - search history backwards
  bindkey "^[[B" history-beginning-search-forward-end   # Down arrow - search history forwards
fi

# Fix key bindings
if [[ "$MACOS" == true ]]; then
  bindkey "^[[H" beginning-of-line
  bindkey "^[[F" end-of-line
  bindkey "^[[3~" delete-char
else
  bindkey "^[[1~" beginning-of-line
  bindkey "^[[4~" end-of-line
  bindkey "^[[3~" delete-char
fi

# Add additional functions
# fcd - fuzzy-find a directory and cd into it (named fcd so it doesn't shadow fd-find)
fcd() {
  local dir
  dir=$(find ${1:-.} -path '*/\.*' -prune -o -type d -print 2> /dev/null | fzf +m) && cd "$dir"
}

# === Additional Functions === #

# Git functions
# Delete branches that have been merged into main/master
git_clean_branches() {
  local main_branch="main"
  if ! git show-ref --quiet refs/heads/main; then
    main_branch="master"
  fi

  echo "Cleaning branches merged into $main_branch..."
  git branch --merged $main_branch | grep -v "\* $main_branch" | xargs -n 1 git branch -d
  echo "Done!"
}

# Interactively add file parts
git_add_interactive() {
  git add -p $@
}

# Show git log with a graph view
git_log_graph() {
  git log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
}

# Add aliases for the functions
alias gclean='git_clean_branches'
alias gai='git_add_interactive'
alias glg='git_log_graph'

# === Python Virtual Environment Indicator === #
# Add virtualenv indicator to the prompt
show_virtual_env() {
  if [ -n "$VIRTUAL_ENV" ]; then
    echo "(🐍 $(basename $VIRTUAL_ENV)) "
  fi
}

# Set up a simple prompt with virtualenv indicator
export VIRTUAL_ENV_DISABLE_PROMPT=1
setopt PROMPT_SUBST

# Only use this custom prompt if Starship isn't active
if [ -z "$STARSHIP_SHELL" ]; then
  export PS1='$(show_virtual_env)%F{cyan}%~%f %F{green}❯%f '
fi

# === Initialize Starship Prompt === #
if command -v starship &> /dev/null; then
  # Create a custom prompt command that prepends the virtualenv
  starship_prompt_cmd() {
    # Get virtualenv indicator
    venv_info="$(show_virtual_env)"

    # Get the standard Starship prompt
    PS1="$venv_info$(starship prompt)"
  }

  # Use precmd to set the prompt
  precmd_functions+=(starship_prompt_cmd)

  # Initialize Starship
  eval "$(starship init zsh --print-full-init | grep -v 'precmd_functions+=(starship_precmd)')"
else
  echo "Starship is not installed. Please install it: https://starship.rs"
fi

command -v uv &> /dev/null && eval "$(uv generate-shell-completion zsh)"

# Lazy-load NVM for faster shell startup
export NVM_DIR="$HOME/.nvm"
if [ -s "$NVM_DIR/nvm.sh" ]; then
  # Defer nvm initialization until first use
  nvm() {
    unset -f nvm node npm npx
    [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
    [ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"
    nvm "$@"
  }
  node() {
    unset -f nvm node npm npx
    [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
    node "$@"
  }
  npm() {
    unset -f nvm node npm npx
    [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
    npm "$@"
  }
  npx() {
    unset -f nvm node npm npx
    [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
    npx "$@"
  }

  # Eagerly put the default Node version's bin on PATH so globally-installed
  # CLIs (e.g. pi) and node itself resolve in a fresh shell WITHOUT first
  # having to trigger nvm. Keeps lazy-loading for nvm itself.
  _nvm_default="$(cat "$NVM_DIR/alias/default" 2>/dev/null)"
  if [ -n "$_nvm_default" ]; then
    _nvm_version="${_nvm_default#v}"
    _nvm_bins=("$NVM_DIR"/versions/node/v${_nvm_version}*/bin(N))
    _nvm_bin="$(printf '%s\n' "${_nvm_bins[@]}" | sort -V | tail -1)"

    # Symbolic defaults such as node, stable, and lts/* do not map directly to
    # a version directory. Resolve those in a subshell so nvm remains lazy in
    # the interactive shell itself.
    if [ -z "$_nvm_bin" ]; then
      _nvm_node="$(
        unset -f nvm node npm npx
        . "$NVM_DIR/nvm.sh" --no-use >/dev/null 2>&1
        nvm which "$_nvm_default" 2>/dev/null
      )"
      if [ -x "$_nvm_node" ]; then
        _nvm_bin="${_nvm_node:h}"
      fi
      unset _nvm_node
    fi

    if [ -n "$_nvm_bin" ]; then
      path=($_nvm_bin $path)
    fi
    unset _nvm_bin _nvm_bins _nvm_version
  fi
  unset _nvm_default
fi


# === Navigation === #
# zoxide: frecency-ranked cd. `z foo` jumps, never draws UI; `zi foo` picks via fzf (kept inline).
if (( $+commands[zoxide] )); then
  export _ZO_EXCLUDE_DIRS="$HOME:$HOME/.cache/*:/tmp/*"
  export _ZO_FZF_OPTS="--height 40% --layout reverse --border top"
  eval "$(zoxide init zsh)"   # must come after compinit
fi

# zsh-syntax-highlighting must be sourced after every widget and completion.
source_plugin zsh-syntax-highlighting
